# VyaparOS Environment Variables Template
# Copy this file to .env and replace placeholders with actual secrets for your environment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vyparos_db
DB_USERNAME=root
DB_PASSWORD=root_password_change_me

# JWT Authentication

JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRATION_MS=86400000

# Server Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080,http://localhost:5173

