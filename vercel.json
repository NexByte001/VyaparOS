{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/favicon.ico", "destination": "/frontend/favicon.ico" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/register.html", "destination": "/frontend/register.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/dashboard.html", "destination": "/frontend/dashboard.html" },
    { "source": "/appointments", "destination": "/frontend/appointments/index.html" },
    { "source": "/appointments/(.*)", "destination": "/frontend/appointments/$1" },
    { "source": "/attendance", "destination": "/frontend/attendance/index.html" },
    { "source": "/attendance/(.*)", "destination": "/frontend/attendance/$1" },
    { "source": "/billing", "destination": "/frontend/billing/index.html" },
    { "source": "/billing/(.*)", "destination": "/frontend/billing/$1" },
    { "source": "/customers", "destination": "/frontend/customers/index.html" },
    { "source": "/customers/(.*)", "destination": "/frontend/customers/$1" },
    { "source": "/finance", "destination": "/frontend/finance/index.html" },
    { "source": "/finance/(.*)", "destination": "/frontend/finance/$1" },
    { "source": "/inventory", "destination": "/frontend/inventory/index.html" },
    { "source": "/inventory/(.*)", "destination": "/frontend/inventory/$1" },
    { "source": "/services", "destination": "/frontend/services/index.html" },
    { "source": "/services/(.*)", "destination": "/frontend/services/$1" },
    { "source": "/settings", "destination": "/frontend/settings/index.html" },
    { "source": "/settings/(.*)", "destination": "/frontend/settings/$1" },
    { "source": "/staff", "destination": "/frontend/staff/index.html" },
    { "source": "/staff/(.*)", "destination": "/frontend/staff/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
